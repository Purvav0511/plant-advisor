# Copy to .env on each machine and fill in values from your password manager.
# Names only here. Never put real values in this file.
# All `uv run poe ...` tasks load .env automatically (including the web app's NEXT_PUBLIC_* vars).
# Keep comments on their own lines: not every .env parser accepts inline comments.

# --- This machine ---
# Label used in docs/PROGRESS.md entries, e.g. mac or pc-wsl
DEV_MACHINE=
# dev | test | prod
APP_ENV=dev

# --- Supabase: shared hosted DEV project (same values on both machines) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=
# Use the Session pooler connection string (IPv4). The direct db.<ref>.supabase.co host is
# IPv6-only, which WSL2 and many home networks can't reach.
DATABASE_URL=
# Local Supabase in Docker, used only by integration tests (the CLI's default; not a secret)
DATABASE_URL_TEST=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Cloudflare R2: shared DEV bucket ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Private prefix for client documents and private eval photos (poe raw-pull / raw-push)
R2_RAW_PREFIX=raw/

# --- Models (paid endpoints only for real data) ---
# replay = recorded responses (unit tests, e2e). Set a real provider for live runs.
MODEL_PROVIDER=replay
MODEL_API_KEY=

# --- Tracing and errors ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
SENTRY_DSN=

# --- Services (same ports on every machine) ---
API_PORT=8000
WORKER_PORT=8001
MCP_PORT=8002
WORKER_URL=http://localhost:8001
WORKER_DRAIN_SECRET=
MCP_SERVICE_TOKEN=
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Email: sign-in codes and ticket links (Resend; needed from PLAN 4.9) ---
EMAIL_API_KEY=
EMAIL_FROM=
# Base URL used in emailed ticket links
APP_BASE_URL=http://localhost:3000

# --- Optional tools ---
# LibreOffice binary, only if it isn't on PATH (needed to convert .doc files during ingestion)
SOFFICE_PATH=

# --- Web app (inlined at build time) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
